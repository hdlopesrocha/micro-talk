# ---------------------------------------------------------------------------
# MicroTalk environment configuration
#
# Copy this file to `.env` and adjust as needed:
#
#     cp .env.example .env
#     docker compose up -d --build
#
# Every value below has the same default in docker-compose.yml, so a `.env`
# file is optional. Changes require `docker compose up -d` to apply.
# ---------------------------------------------------------------------------

# Host port for the web interface. This is the ONLY published port.
MICROTALK_PORT=8080

# --- Access control --------------------------------------------------------
# Leave empty for a local single-user instance with no login. When set, the
# browser is asked for this token and the gateway accepts it as a Bearer token
# or a `token` query parameter (used by audio/subtitle elements and SSE).
GATEWAY_AUTH_TOKEN=

# --- Upload and workflow limits -------------------------------------------
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=2000
GATEWAY_MAX_TEXT_CHARS=500000
GATEWAY_MAX_ACTIVE_JOBS=12
TTS_MAX_TEXT_CHARS=500000
TTS_MAX_SENTENCES=5000
TTS_MAX_QUEUE=20
JOB_TIMEOUT_SECONDS=21600
SERVICE_REQUEST_TIMEOUT_SECONDS=1800
TTS_POLL_INTERVAL_SECONDS=1.5

# --- Retention and housekeeping ------------------------------------------
# Set CLEANUP_ENABLED=false to keep every generated file forever (not
# recommended for a small disk).
CLEANUP_ENABLED=true
GATEWAY_RETENTION_HOURS=168
PDF_RETENTION_HOURS=168
TTS_RETENTION_HOURS=72
MEDIA_RETENTION_HOURS=168
CLEANUP_INTERVAL_SECONDS=1800
MINIMUM_FREE_DISK_MB=500

# --- CPU and model lifecycle ---------------------------------------------
# CPU_THREADS is shared by the PDF, translation, summary and TTS services.
# Keep the sum of simultaneous ML work within the machine's CPU budget.
CPU_THREADS=4
# Unload idle translation/summary models after 15 minutes to free RAM.
# Use 0 to keep models resident.
MODEL_IDLE_UNLOAD_SECONDS=900

# --- Rate limiting (Redis fixed window) ----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=180
UPLOAD_RATE_LIMIT_PER_MINUTE=30
JOB_RATE_LIMIT_PER_MINUTE=12

# --- PDF extraction -------------------------------------------------------
# Tesseract language packs installed in the image: por + eng.
OCR_ENABLED_DEFAULT=false
OCR_LANGUAGES=por+eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=180
OCR_MIN_CHARS=40

# --- Translation ----------------------------------------------------------
# Models are downloaded ONLY by the explicit command:
#   docker compose run --rm translation-service download-models
TRANSLATION_MODEL_PT_EN=Helsinki-NLP/opus-mt-roa-en
TRANSLATION_MODEL_EN_PT=Helsinki-NLP/opus-mt-tc-big-en-pt
DEFAULT_SOURCE_LANGUAGE=pt
DEFAULT_TARGET_LANGUAGE=en
MAX_TRANSLATION_CHARS=500000
TRANSLATION_CHUNK_CHARS=850
TRANSLATION_NUM_BEAMS=2
TRANSLATION_MAX_TOKENS=512

# --- Summarization --------------------------------------------------------
# Models are downloaded ONLY by the explicit command:
#   docker compose run --rm summary-service download-models
SUMMARY_MODEL_EN=farleyknight/cnn_dailymail-summarization-t5-small-2022-09-08
SUMMARY_MODEL_PT=rhaymison/t5-portuguese-small-summarization
SUMMARY_MODEL_EN_REVISION=main
SUMMARY_MODEL_PT_REVISION=main
SUMMARY_PROMPT_EN="summarize: "
SUMMARY_PROMPT_PT="sumarize: "
SUMMARY_MAX_INPUT_CHARS=500000
SUMMARY_MAX_INPUT_TOKENS=480
SUMMARY_MAX_CHUNKS=300
SUMMARY_NUM_BEAMS=3
SUMMARY_SHORT_TOKENS=120
SUMMARY_MEDIUM_TOKENS=240
SUMMARY_LONG_TOKENS=420
SUMMARY_TRANSLATION_TIMEOUT=900

# --- Speech synthesis -----------------------------------------------------
# Piper voice files are downloaded ONLY by:
#   docker compose run --rm tts-service download-models
DEFAULT_TTS_VOICE=pt-PT-tugao
DEFAULT_TTS_LANGUAGE=pt-PT
DEFAULT_TTS_SPEED=1.0
TTS_MAX_SEGMENT_CHARS=400
TTS_SENTENCE_GAP_MS=120
TTS_ENABLE_WAV=true

# --- Media / FFmpeg -------------------------------------------------------
MEDIA_MAX_UPLOAD_MB=500
MEDIA_MP3_BITRATE=128k
FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=60
SUBTITLE_WORDS_PER_MINUTE=150

# --- Logging / CORS -------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
